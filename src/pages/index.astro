---
// Root page — detects browser language client-side and redirects.
// Do NOT add a `/ /en/ 302` rule in public/_redirects; the edge redirect
// would fire before this page loads and the language detection would never run.
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Link2Send</title>
    <link rel="alternate" hreflang="en" href="https://link2send.com/en/" />
    <link rel="alternate" hreflang="zh" href="https://link2send.com/zh/" />
    <link rel="alternate" hreflang="x-default" href="https://link2send.com/en/" />
    <script is:inline>
      (function () {
        var lang = (navigator.language || navigator.userLanguage || "en").toLowerCase();
        window.location.replace(lang.indexOf("zh") === 0 ? "/zh/" : "/en/");
      })();
    </script>
    <meta http-equiv="refresh" content="1;url=/en/" />
  </head>
  <body>
    <noscript>
      <p>
        <a href="/en/">English</a> | <a href="/zh/">中文</a>
      </p>
    </noscript>
  </body>
</html>
